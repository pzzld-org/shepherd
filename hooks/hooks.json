{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shepherd",
            "args": ["claude-hook"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "shepherd",
            "args": ["claude-hook"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shepherd",
            "args": ["claude-hook"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shepherd",
            "args": ["claude-hook"]
          }
        ]
      }
    ]
  }
}

# Every checkout must materialize the same text bytes. This is release-critical:
# LICENSE, shell installers, WIT and generated carrier text are copied directly
# into cross-platform archives, then verified byte-for-byte. Windows runners
# otherwise default to core.autocrlf=true and silently produce divergent payloads.
* text=auto eol=lf

# Append-only audit ledger: concurrent worktrees may both add verdict lines.
# Git's union driver preserves both additions instead of choosing one side.
.shepherd/runs/*/auditor-verdicts.txt merge=union

#!/usr/bin/env bash
# commit-msg — advisory conventional-commit check.
#
# ADVISORY, NOT BLOCKING, AND THAT IS DELIBERATE. The release workflow reads
# CHANGELOG.md rather than parsing commit subjects, so a non-conventional
# subject breaks nothing mechanical. Blocking on it would mean this repo's own
# history (`update`, `update`) could not have been written, and a hook that
# blocks work it cannot justify is a hook that gets turned off — taking the
# pre-commit gate with it, since `core.hooksPath` is all-or-nothing.
#
# So it prints and gets out of the way. The one thing it DOES block is an empty
# subject, because that is never intentional.
#
# Conventional prefixes in use across this repo:
#   feat  fix  docs  style  refactor  perf  test  build  ci  chore  revert
set -euo pipefail

MSG_FILE="${1}"
[ -f "${MSG_FILE}" ] || exit 0

# Strip comments and leading blank lines to find the real subject.
SUBJECT="$(grep -vE '^\s*#' "${MSG_FILE}" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"

# A merge, revert, fixup or squash subject is generated by git itself.
case "${SUBJECT}" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if [ -z "${SUBJECT}" ]; then
  printf 'commit-msg: refusing an empty commit message.\n' >&2
  exit 1
fi

CONVENTIONAL='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "${SUBJECT}" | grep -qE "${CONVENTIONAL}"; then
  cat >&2 <<MSG
commit-msg: subject is not a conventional commit (advisory, not blocking).

  got:      ${SUBJECT}
  expected: <type>(<scope>): <summary>
  types:    feat fix docs style refactor perf test build ci chore revert

MSG
elif [ "${#SUBJECT}" -gt 72 ]; then
  printf 'commit-msg: subject is %d characters; 72 is the wrap point (advisory).\n' \
    "${#SUBJECT}" >&2
fi

exit 0

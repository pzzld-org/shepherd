#!/usr/bin/env bash
# pre-push — intentionally non-blocking.
#
# Git hooks run before the remote accepts a push. Compiling the workspace or
# opening a pull request here therefore turns a local convenience into an
# unavailable-push failure mode. CI and explicit `scripts/gate.sh` invocations
# own those checks; GitHub users own PR creation.
set -euo pipefail

printf 'pre-push: no local gate or PR automation ran; use scripts/gate.sh explicitly when needed.\n' >&2
exit 0

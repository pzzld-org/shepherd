#!/usr/bin/env bash
# pre-push — the full gate, then sprint PR bookkeeping.
#
# WHY THIS FILE EXISTS. `.githooks/open-sprint-pr` was tracked, executable, and
# never ran: `core.hooksPath` was unset, so git looked in `.git/hooks/` (samples
# only), and even pointed at `.githooks/` the name `open-sprint-pr` is not a git
# hook name. Git has a fixed vocabulary of hook filenames; anything else is an
# inert script sitting in a hooks directory. So the repo carried a hook-shaped
# file that no git operation could ever invoke.
#
# WHY THE GATE RUNS HERE AND NOT AT COMMIT. CLAUDE.md budgets the per-commit
# gate at under two seconds, which rules out anything that compiles. Push is the
# next boundary and the last one that is still local and free: it is the moment
# before CI spends runner minutes and before anyone else can pull the work.
# `pre-commit` runs the fast tier; this runs the full one.
#
# WHY open-sprint-pr IS ON pre-push AND NOT pre-commit. It requires the branch
# to already exist on the remote — it calls `git ls-remote --exit-code --heads`
# and exits early when the branch is absent. A pre-commit hook runs before any
# push has happened, so on a fresh sprint branch it would take that early exit
# every time and never open anything. It also shells out to `gh api` over the
# network, which is the wrong cost to pay on every commit.
#
# pre-push is the only client-side push hook git offers. Running open-sprint-pr
# here means: first push creates the branch remotely and the hook takes its
# early exit; every subsequent push finds the branch and opens the draft PR if
# one is not already open. That is one push of latency, and it is the closest
# git gets to "after push" without a server-side hook.
#
# NOT ENABLED BY DEFAULT. This file does nothing until someone sets
#   git config core.hooksPath .githooks
# which is LOCAL config and cannot be committed. That is deliberate: turning it
# on causes an outward-facing action (opening a PR on GitHub), so it is the
# operator's switch to throw, not something a clone silently inherits.
# `scripts/setup.sh` throws it.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GATE="${REPO_ROOT}/scripts/gate.sh"
SPRINT_PR="${HOOK_DIR}/open-sprint-pr"

# --- 1. The gate. This one IS allowed to block. ----------------------------- #
#
# A red push costs CI minutes and, on a sprint branch, blocks whoever pulls it
# next. That is worth the wall-clock here.
if [ "${SHEPHERD_SKIP_GATE:-0}" = "1" ]; then
  printf 'pre-push: gate skipped via SHEPHERD_SKIP_GATE=1\n' >&2
elif [ -x "${GATE}" ]; then
  if ! "${GATE}" full; then
    cat >&2 <<'MSG'

pre-push: the full gate failed. The push was NOT performed.

Fix the underlying issue rather than bypassing the hook — CLAUDE.md bans
`--no-verify`. Re-run any single tier directly:

    scripts/gate.sh fast     formatting + workspace invariants
    scripts/gate.sh full     the above, plus clippy, tests, feature matrix
    scripts/gate.sh wasm     the WASI execution suite

If you must publish a known-broken branch (handing off a WIP sprint lane, say):

    SHEPHERD_SKIP_GATE=1 git push ...

MSG
    exit 1
  fi
fi

# --- 2. PR bookkeeping. This one is NEVER allowed to block. ----------------- #
#
# open-sprint-pr exits 1 on a genuine GitHub API failure, and a failed `gh api`
# call is not a reason to refuse to publish commits — the push is the thing that
# matters, the draft PR is convenience. Report the failure, exit 0.
[ -x "${SPRINT_PR}" ] || exit 0

if ! "${SPRINT_PR}" "$@"; then
  printf 'pre-push: open-sprint-pr failed; push continues (PR bookkeeping is not a gate).\n' >&2
fi
exit 0

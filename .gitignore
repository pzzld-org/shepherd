# General
*.bk
*.bk.*

# Claude Code agent worktrees — transient, created by Agent isolation:worktree
# (registered git worktrees; never tracked in the plugin repo)
.claude/worktrees/

# shepherd lane worktrees — created by /shepherd:spawn as
# `git worktree add .worktrees/{sprint_slug}-{lane_id}` (commands/spawn.md
# §Pre-spawn worktree creation). These are registered git worktrees holding a
# full checkout EACH, plus per-lane CARGO_TARGET_DIR output: measured at 3.8 GB
# for a 6-lane sprint in this repo. Without this rule every spawn leaves a
# multi-gigabyte untracked directory sitting in `git status`, and `git add -A`
# during a wave commit would stage another checkout of the whole repo into
# itself. The rule above only ever covered `.claude/worktrees/` — a path the
# plugin does not use.
.worktrees/

*.db
*.db.*

# Canonical Shepherd registry and lock state. Retired namespace roots are not
# ignored: if `.artifacts/` or `.shepherd/{cache,logs,memory,tmp,...}` returns,
# it must be visible in `git status` and rejected by the layout gate.
.shepherd/shepherd.db
.shepherd/shepherd.db-journal
.shepherd/shepherd.db-wal
.shepherd/shepherd.db-shm
.shepherd/shepherd.lock
.shepherd/project.json
# Under runs/, durable human artifacts are tracked while machine state,
# dispatch records, events, snapshots, and fixtures remain local by default.
#
.shepherd/runs/**
!.shepherd/runs/*/
!.shepherd/runs/*/seed.md
!.shepherd/runs/*/mesh.md
!.shepherd/runs/*/plan.md
!.shepherd/runs/*/phase0.md
!.shepherd/runs/*/close.md
!.shepherd/runs/*/handoff.md
!.shepherd/runs/*/carry-forward.md
!.shepherd/runs/*/dogfood.md
!.shepherd/runs/*/lanes/
!.shepherd/runs/*/lanes/*/
!.shepherd/runs/*/lanes/*/plan.md
# A lane's evidence is a release artifact, not scratch: GATE-CAN-FAIL requires
# the failing output be recorded in the lane artifact, and the close report
# carries the harness-parity table. Markdown and re-runnable reproduction
# scripts are durable; dispatch records, events, and fixtures stay local.
!.shepherd/runs/*/lanes/*/*.md
!.shepherd/runs/*/lanes/*/*.sh
!.shepherd/runs/*/lanes/*/reference/
!.shepherd/runs/*/lanes/*/reference/*
!.shepherd/runs/*/lanes/*/evidence/
!.shepherd/runs/*/lanes/*/evidence/*
!.shepherd/runs/*/harness-parity.md
# Durable analysis output is tracked.
!.shepherd/runs/*/reports/
!.shepherd/runs/*/reports/*.md
!.shepherd/runs/*/audits/
!.shepherd/runs/*/audits/*.md

*.log
*.log.*

*.pem
*.pem.*

*.gz
*.gz.*

*.sqlite
*.sqlite.*

*.sqlite3
*.sqlite3.*

*.zip
*.zip.*


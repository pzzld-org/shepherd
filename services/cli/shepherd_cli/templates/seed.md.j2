{#
  Seed scaffold: .shepherd/runs/{run}/seed.md — structure per
  skills/shepherd/references/seed-template.md. The planter authors the
  section bodies; this scaffold pins the frontmatter and section order so
  `shepherd seed verify` and the engineer's Phase-0 mesh always parse the
  same shape.
#}
---
title: {{ sprint_branch }} Seed — {{ theme }}
branch: {{ sprint_branch }}
base: {{ patch_branch }}
kind: {{ kind }}
status: draft
date: {{ date }}
revised: {{ date }}
author: {{ author }}
prior_sprint: {{ prior_sprint }}
prior_close_report: {{ prior_close_report }}
prior_handoff: {{ prior_handoff }}
patch_seed: {{ patch_seed }}
planter_mesh: {{ planter_mesh }}
milestone: {{ milestone }}
sprint_dependencies: {{ sprint_dependencies | tojson }}
parallel_with: {{ parallel_with | tojson }}
sprint_size: {{ sprint_size }}
file_scope:
  exclusive:
{% for path in file_scope_exclusive %}
    - {{ path }}
{% endfor %}
  additive:
{% for path in file_scope_additive %}
    - {{ path }}
{% endfor %}
---

# North star

# Why this sprint

# Priors / lessons carried forward

# Sprint character

# Phase 0 mesh mandate

# Engineering decisions (locked)

# Deliverables (issue-anchored)

# Outcome verification

# Wave composition (non-binding)

# Carry-forward dispositions

# Drift-risk items

# Non-goals

# Open questions for critic

# References

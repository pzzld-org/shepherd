{
  "description": "Codex native identity and shared Rust guard transport wiring.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/shepherd_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Binding primary Shepherd session identity"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/shepherd_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Publishing native Shepherd dispatch identity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/shepherd_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Shepherd guard predicates"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/shepherd_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Closing native Shepherd dispatch identity"
          }
        ]
      }
    ]
  }
}

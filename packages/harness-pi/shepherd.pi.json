{
  "$schema": "https://json.schemastore.org/package.json",
  "contract": "fl03:shepherd@6.4.5",
  "adapter": "pi",
  "extension": "./src/extension.mjs",
  "provider": {
    "name": "subagent-provider",
    "package": "pi-subagents",
    "requiredMethods": ["capabilities", "spawn", "resume", "stop"],
    "failClosedWhenAbsent": true,
    "failClosedWhenNotReady": true
  },
  "component": {
    "moduleEnv": "SHEPHERD_COMPONENT_MODULE",
    "requiredExports": [
      "canonicalProfile",
      "compileCanonical",
      "measure",
      "guardEvalCanonical",
      "normalizeIdentity",
      "planLifecycle",
      "evaluateProvider",
      "validateResponse",
      "validateNativeResponse",
      "validateNativeExchange"
    ]
  },
  "transitions": {
    "resume": "publish-native-dispatch-resume",
    "stop": "publish-native-dispatch-stop"
  }
}

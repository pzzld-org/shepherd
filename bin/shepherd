#!/usr/bin/env bash
# Compatibility launcher for the one canonical native shepherd executable.
#
# This file deliberately owns only deterministic binary location selection.
# It never starts an interpreter, package manager, or legacy command script.
set -euo pipefail

resolve_executable() {
  local path="$1" target directory
  while [[ -L "$path" ]]; do
    target="$(readlink "$path")" || return 1
    if [[ "$target" = /* ]]; then
      path="$target"
    else
      path="$(dirname "$path")/$target"
    fi
  done
  directory="$(cd "$(dirname "$path")" && pwd -P)" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

if [[ -n "${SHEPHERD_NATIVE_BIN:-}" ]]; then
  candidate="$SHEPHERD_NATIVE_BIN"
else
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  launcher="$(resolve_executable "${BASH_SOURCE[0]}")"
  candidate="$root/target/release/shepherd"
  if [[ ! -x "$candidate" ]]; then
    candidate="$root/target/debug/shepherd"
  fi
  if [[ ! -x "$candidate" ]]; then
    installed="$(command -v shepherd 2>/dev/null || true)"
    if [[ -n "$installed" && -x "$installed" ]] \
      && [[ "$(resolve_executable "$installed")" != "$launcher" ]]; then
      candidate="$installed"
    fi
  fi
fi

if [[ ! -x "$candidate" ]]; then
  printf '%s\n' 'shepherd: native binary unavailable.' >&2
  printf '%s\n' "shepherd: expected executable at $candidate." >&2
  printf '%s\n' 'shepherd: install the native shepherd release or set SHEPHERD_NATIVE_BIN to its executable path.' >&2
  exit 127
fi

exec "$candidate" "$@"

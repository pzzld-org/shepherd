#!/usr/bin/env bash
# bin/shepherd -- resolver shim that fills the PATH slot the harness reserves.
#
# The Claude Code harness puts `<plugin-root>/bin` on PATH for every hook
# subprocess, and `hooks/hooks.json` invokes the bare command "shepherd" at
# four call sites (e.g. `"command": "shepherd", "args": ["claude-hook"]`).
# Between v6.4.5 (bin/shepherd deleted, #307 -- the old launcher shadowed the
# cargo-installed binary and exited 127) and v6.5.0, nothing filled that PATH
# slot: `plugins/shepherd/bin` did not exist, `command -v shepherd` failed
# inside every plugin-hosted hook process, and every native hook silently
# no-oped -- no error, no signal, just a missing effect. This restores the
# slot. It resolves the real CLI and execs into it; it is not a second CLI
# implementation (the v6.4.4 shim it replaces wrapped a Poetry/Python venv --
# that CLI is gone, replaced by the Rust binary at crates/cli, `[[bin]] name
# = "shepherd"`, `path = "bin/cli.rs"`).
#
# Resolution order, first existing executable file wins:
#   1. $SHEPHERD_BIN                    -- explicit operator override; the
#                                          same variable scripts/check-version-lag.py
#                                          already honors.
#   2. <this dir>/shepherd-native       -- a binary a future release may ship
#                                          alongside this shim inside the
#                                          plugin carrier (plugins/shepherd/bin/,
#                                          which is `../../bin` -> this file's
#                                          directory). Named "shepherd-native",
#                                          not "shepherd", so a same-directory
#                                          drop-in can never collide with this
#                                          shim's own filename.
#   3. ${CARGO_HOME:-$HOME/.cargo}/bin/shepherd -- the `cargo install` target.
#   4. PATH, excluding this script's own directory -- catches any other
#      install (package manager, manual symlink) without re-finding this shim.
# No other source is consulted -- do not add one without updating this list.
#
# Self-recursion (R1): this file is installed ON PATH as `shepherd`, so a
# naive `exec shepherd "$@"` would re-invoke itself forever. Every candidate
# above is realpath-compared against this script's own realpath and skipped
# on a match, on top of excluding this script's directory from the PATH walk
# in step 4 -- belt and suspenders, since a symlinked cache path and its
# target can differ textually while naming the same file.
#
# Exit code on failure is deliberately non-blocking. Claude Code hooks treat
# exit 2 as BLOCKING (stderr is fed back to the model and the tool call is
# refused); a missing CLI must not turn into a silent Write/Edit/Bash denial
# for the rest of the session, so this exits 1, never 2, on every failure path.
#
# bash 3.2 is the host shell (macOS ships it; repo issue #340) and it does
# NOT treat a failing line-initial `[[ ... ]]` as fatal under `set -e` -- so
# this script never relies on `set -e` for control flow (only `-u` and
# `-o pipefail` are set) and every test that must gate an action does so with
# an explicit `|| { ...; exit 1; }` or `|| continue`, never a bare assertion.

set -u -o pipefail

# Resolve a path to its real, symlink-free absolute form. Portable: BSD
# `readlink` (macOS) has no `-f` this script can assume, and GNU `realpath`
# is coreutils-only and absent by default on macOS, so this walks the
# `readlink` chain by hand. Bounded at 40 hops so a symlink cycle fails
# instead of spinning.
#
# `dirname`/`basename` are deliberately NOT used here: they are external
# binaries (not bash builtins), and this function must stay correct even
# when PATH is minimal (the self-recursion test below runs with a PATH
# containing only this script's own directory). A missing `dirname` would
# make `$(dirname "$target")` fail closed to empty/`$PWD`-relative garbage
# instead of failing loudly, which would make self-detection unreliable in
# exactly the scenario R1 exists to cover. Parameter expansion has no such
# dependency. `_pdirname` assumes its argument is already absolute (true for
# every call site below).
_pdirname() {
  local d="${1%/*}"
  [ -n "$d" ] || d="/"
  printf '%s\n' "$d"
}
_pbasename() {
  printf '%s\n' "${1##*/}"
}

resolve_realpath() {
  local target="$1" dir base hops=0
  case "$target" in
    /*) : ;;
    *) target="$PWD/$target" ;;
  esac
  while [ -L "$target" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || { printf 'FAIL: symlink cycle resolving %s\n' "$1" >&2; return 1; }
    dir="$(_pdirname "$target")"
    base="$(readlink "$target")" || { printf 'FAIL: readlink failed on %s\n' "$target" >&2; return 1; }
    case "$base" in
      /*) target="$base" ;;
      *) target="$dir/$base" ;;
    esac
  done
  dir="$(cd "$(_pdirname "$target")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(_pbasename "$target")"
}

SELF_SRC="${BASH_SOURCE[0]:-$0}"
SELF_REAL="$(resolve_realpath "$SELF_SRC")" || {
  printf "FAIL: could not resolve this script's own path (%s)\n" "$SELF_SRC" >&2
  exit 1
}
SELF_DIR="$(_pdirname "$SELF_REAL")"

# Is this file (by realpath) the shim itself? Used to reject every candidate
# below, so `shepherd` can never resolve to `shepherd`.
is_self() {
  local candidate_real
  candidate_real="$(resolve_realpath "$1")" || return 1
  [ "$candidate_real" = "$SELF_REAL" ]
}

# 1. $SHEPHERD_BIN -- explicit operator override.
candidates=("${SHEPHERD_BIN:-}")

# 2. A binary shipped next to this shim inside the plugin carrier.
candidates+=("$SELF_DIR/shepherd-native")

# 3. The `cargo install` target.
cargo_home="${CARGO_HOME:-}"
[ -n "$cargo_home" ] || cargo_home="${HOME:-}/.cargo"
candidates+=("$cargo_home/bin/shepherd")

# 4. PATH, excluding this script's own directory, first match wins.
path_candidate=""
IFS=':' read -r -a path_dirs <<< "${PATH:-}"
for path_dir in "${path_dirs[@]+"${path_dirs[@]}"}"; do
  [ -n "$path_dir" ] || continue
  [ "$path_dir" != "$SELF_DIR" ] || continue
  probe="$path_dir/shepherd"
  [ -f "$probe" ] && [ -x "$probe" ] || continue
  is_self "$probe" && continue
  path_candidate="$probe"
  break
done
[ -z "$path_candidate" ] || candidates+=("$path_candidate")

resolved=""
for candidate in "${candidates[@]}"; do
  [ -n "$candidate" ] || continue
  [ -f "$candidate" ] && [ -x "$candidate" ] || continue
  is_self "$candidate" && continue
  resolved="$candidate"
  break
done

if [ -z "$resolved" ]; then
  {
    # shellcheck disable=SC2016 # literal "$SHEPHERD_BIN" is meant for the reader, not expansion
    printf 'shepherd: no shepherd CLI binary found (checked $SHEPHERD_BIN, %s,\n' "$SELF_DIR/shepherd-native"
    printf '          %s/bin/shepherd, and PATH). Install it with:\n' "$cargo_home"
    printf '\n'
    printf '            cargo install --path crates/cli --locked\n'
    printf '\n'
    printf '          or point SHEPHERD_BIN at an existing binary.\n'
  } >&2
  # Non-blocking (see header): a missing CLI must not exit 2 and deny every
  # subsequent tool call for the rest of the session.
  exit 1
fi

# Preserve the caller's cwd (never `cd` first) and pass args through
# unmodified. Never print to stdout above this line -- `shepherd ... --json`
# output is parsed by hooks and agents, so anything diagnostic goes to stderr.
exec "$resolved" "$@"

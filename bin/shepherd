#!/usr/bin/env bash
# bin/shepherd -- the single canonical entrypoint for the shepherd CLI.
#
# One entrypoint, one CLI. Prefers `poetry run` inside services/cli/ (dev + CI
# use this path directly); falls back to `python3 -m shepherd_cli` on
# PYTHONPATH when poetry is absent (an end user relying on the venv that
# bin/shepherd-venv-ensure maintains, or a minimal image). The Python package
# is the sole owner of CLI logic -- the loose skills/context/scripts/cmd_*.sh
# shell layer is retired behind this surface.
set -eu -o pipefail

# Resolve the plugin root: prefer ${CLAUDE_PLUGIN_ROOT} (set by Claude Code when
# the plugin is installed); otherwise derive it from this script's own location
# so `bin/shepherd` also works run directly from a repo clone.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  ROOT="$CLAUDE_PLUGIN_ROOT"
else
  SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  ROOT="$(dirname "$SELF")"
fi

CLI_DIR="$ROOT/services/cli"

# `poetry -C <dir> run` executes the command with its OWN cwd set to <dir>,
# so every relative path argument would resolve against services/cli/ instead
# of the caller's directory (`shepherd seed verify my.seed.md` from a repo
# became "no such file"). Resolve the venv interpreter and exec it directly,
# preserving the caller's cwd. Falls back to `poetry run` only when the venv
# path cannot be resolved.
if command -v poetry >/dev/null 2>&1; then
  VENV_PY="$(poetry -C "$CLI_DIR" env info --executable 2>/dev/null || true)"
  if [ -n "$VENV_PY" ] && [ -x "$VENV_PY" ]; then
    exec env PYTHONPATH="$CLI_DIR${PYTHONPATH:+:$PYTHONPATH}" "$VENV_PY" -m shepherd_cli "$@"
  fi
  exec poetry -C "$CLI_DIR" run shepherd "$@"
fi

exec env PYTHONPATH="$CLI_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 -m shepherd_cli "$@"
